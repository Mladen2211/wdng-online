{
  "name": "wdng-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/app",
    "dev:api": "npm run dev --workspace=packages/api",
    "build": "npm run build --workspace=packages/app",
    "build:api": "npm run build --workspace=packages/api",
    "start": "npm run start --workspace=packages/app",
    "start:api": "npm run start --workspace=packages/api",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "install:all": "npm install"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.5",
    "mapbox-gl": "^3.17.0",
    "react-map-gl": "^8.1.0",
    "sonner": "^2.0.7"
  }
}
